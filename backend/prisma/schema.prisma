// Prisma Schema — 모의시험 플랫폼
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────
// Course — 과정 (e.g. "OO대학교 네이버클라우드 아카데미")
// 여러 계정과 여러 시험을 묶는 단위
// ─────────────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
  exams Exam[]

  @@map("courses")
}

// ─────────────────────────────────────────
// User — 사용자 계정
// ─────────────────────────────────────────
model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String
  role        Role         @default(USER)
  courseId    String?      // 소속 과정 (nullable)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  submissions Submission[]
  userExams   UserExam[]

  @@index([courseId])
  @@map("users")
}

// ─────────────────────────────────────────
// Exam — 시험지
// ─────────────────────────────────────────
model Exam {
  id          String       @id @default(cuid())
  title       String
  description String?
  duration    Int
  isPublished Boolean      @default(false)
  courseId    String?      // 소속 과정 (nullable)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions   Question[]
  submissions Submission[]
  userExams   UserExam[]

  @@index([courseId])
  @@map("exams")
}

// ─────────────────────────────────────────
// Question — 문제
// ─────────────────────────────────────────
model Question {
  id        String   @id @default(cuid())
  examId    String
  content   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  choices Choice[]
  answers Answer[]

  @@index([examId])
  @@map("questions")
}

// ─────────────────────────────────────────
// Choice — 선택지
// ─────────────────────────────────────────
model Choice {
  id         String   @id @default(cuid())
  questionId String
  content    String
  isCorrect  Boolean  @default(false)
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([questionId])
  @@map("choices")
}

// ─────────────────────────────────────────
// Submission — 응시 기록
// ─────────────────────────────────────────
model Submission {
  id             String   @id @default(cuid())
  userId         String
  examId         String
  score          Int?
  totalQuestions Int
  submittedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([userId])
  @@index([examId])
  @@map("submissions")
}

// ─────────────────────────────────────────
// UserExam — 시험-사용자 개별 매핑 (기존 유지)
// Course 매핑과 별개로, 특정 사용자에게 개별 시험 할당 가능
// ─────────────────────────────────────────
model UserExam {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
  @@map("user_exams")
}

// ─────────────────────────────────────────
// Answer — 개별 답안
// ─────────────────────────────────────────
model Answer {
  id           String  @id @default(cuid())
  submissionId String
  questionId   String
  choiceId     String
  isCorrect    Boolean

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id])
  choice     Choice     @relation(fields: [choiceId], references: [id])

  @@index([submissionId])
  @@map("answers")
}
