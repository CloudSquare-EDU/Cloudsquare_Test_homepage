# NCP 배포용 환경변수 — 이 파일을 .env.prod로 복사 후 값 입력
# cp backend/.env.prod.example backend/.env.prod

# NCP Cloud DB (PostgreSQL) 연결 정보
DATABASE_URL="postgresql://유저명:비밀번호@NCP-DB-호스트:5432/mockexam"

# JWT — 반드시 강력한 랜덤값으로 변경
# 생성 명령: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="여기에_강력한_랜덤값_입력"
JWT_EXPIRES_IN="7d"

# 서버 설정
PORT=3001
NODE_ENV=production

# 프론트엔드 도메인 (CORS 허용 대상)
FRONTEND_URL="https://your-domain.com"
